# Kopie nach .env und Werte eintragen. .env wird beim Deploy geladen und ist in .gitignore.

# Einladungs-E-Mail: Secret (muss mit Next.js .env.local übereinstimmen)
INVITATION_EMAIL_SECRET=

# E-Mail-Versand per SMTP (Einladungen, Stundennachweise, Einrichtungs-Mails).
# Zugangsdaten des Mail-Anbieters, z. B. noreply@aufabruf.eu.
# SMTP_SECURE nur bei Port 465 setzen (jeder Wert zählt als "an");
# bei Port 587/STARTTLS die Variable komplett weglassen.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@aufabruf.eu
# SMTP_PASS=
# SMTP_FROM=SchichtKlar <noreply@aufabruf.eu>
# SMTP_SECURE=1
